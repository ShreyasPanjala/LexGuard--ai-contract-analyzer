# EditorConfig — https://editorconfig.org
root = true

# All files
[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
trim_trailing_whitespace = true
insert_final_newline = true

# JavaScript / TypeScript / JSX / TSX
[*.{js,jsx,ts,tsx,mjs,cjs}]
indent_size = 2

# JSON
[*.{json,jsonc}]
indent_size = 2

# HTML
[*.html]
indent_size = 2

# CSS / SCSS / PostCSS
[*.{css,scss,sass,less,pcss}]
indent_size = 2

# YAML
[*.{yml,yaml}]
indent_size = 2

# Markdown
[*.md]
trim_trailing_whitespace = false
indent_size = 2

# Shell scripts
[*.sh]
indent_size = 2
end_of_line = lf

# Batch scripts (Windows)
[*.{bat,cmd}]
end_of_line = crlf
